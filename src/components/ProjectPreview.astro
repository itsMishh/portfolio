---
// Hand-drawn stand-in for a project screenshot: a wireframe of the app in the
// site's sketch style. Used when a project has no `image` yet.
interface Props {
  variant?: 'app';
}
const { variant = 'app' } = Astro.props;
---

<svg viewBox="0 0 320 180" class="h-full w-full" role="img" aria-label="Sketch of the app interface" data-variant={variant}>
  <rect width="320" height="180" fill="var(--color-cream)" />

  <!-- Sidebar -->
  <path d="M86 4 L86 176" stroke="var(--color-ash-light)" stroke-width="1.2" stroke-dasharray="3 2" fill="none" />
  <circle cx="22" cy="22" r="7" stroke="var(--color-ink-light)" stroke-width="1.2" fill="none" />
  <path d="M19 22 l2.5 2.5 L26 19" stroke="var(--color-ink-light)" stroke-width="1.2" fill="none" stroke-linecap="round" />
  {
    [48, 68, 88, 108].map((y, i) => (
      <g>
        <rect x="14" y={y} width="10" height="10" rx="2" stroke="var(--color-ash)" stroke-width="1.1" fill={i === 0 ? 'var(--color-ink)' : 'none'} />
        <path d={`M30 ${y + 5} h${i === 0 ? 40 : 34}`} stroke={i === 0 ? 'var(--color-ink)' : 'var(--color-ash)'} stroke-width={i === 0 ? 2 : 1.6} stroke-linecap="round" />
      </g>
    ))
  }

  <!-- Page heading -->
  <path d="M104 26 h86" stroke="var(--color-ink)" stroke-width="3.4" stroke-linecap="round" />
  <path d="M104 36 C124 34.5 144 37.5 164 36" stroke="var(--color-ash-light)" stroke-width="1.2" fill="none" stroke-linecap="round" />

  <!-- Phrase cards -->
  {
    [52, 96].map((y) => (
      <g>
        <rect x="104" y={y} width="122" height="34" rx="3" stroke="var(--color-ash-light)" stroke-width="1.2" stroke-dasharray="3 2" fill="var(--color-cream-dark)" />
        <path d={`M112 ${y + 13} h74`} stroke="var(--color-ink-light)" stroke-width="2" stroke-linecap="round" />
        <path d={`M112 ${y + 23} h48`} stroke="var(--color-ash)" stroke-width="1.6" stroke-linecap="round" />
        <circle cx="214" cy={y + 17} r="6" stroke="var(--color-ink-light)" stroke-width="1.2" fill="none" />
        <path d={`M211.5 ${y + 14.5} v5 l3 -2.5 z`} fill="var(--color-ink-light)" />
      </g>
    ))
  }

  <!-- Streak panel -->
  <rect x="238" y="52" width="68" height="78" rx="3" stroke="var(--color-ash-light)" stroke-width="1.2" stroke-dasharray="3 2" fill="none" />
  <path d="M246 64 h30" stroke="var(--color-ash)" stroke-width="1.6" stroke-linecap="round" />
  <text x="248" y="92" font-family="Caveat, cursive" font-size="26" fill="var(--color-ink)">7</text>
  <path d="M268 86 c4 -6 2 -10 -1 -13 c4 2 9 7 7 14" stroke="var(--color-ink)" stroke-width="1.3" fill="none" stroke-linejoin="round" />
  {
    [0, 1, 2, 3, 4, 5, 6].map((i) => (
      <circle cx={247 + i * 9} cy="114" r="3" stroke="var(--color-ink-light)" stroke-width="1.1" fill={i < 5 ? 'var(--color-ink-light)' : 'none'} />
    ))
  }

  <!-- Writing lines -->
  {
    [146, 156, 166].map((y, i) => (
      <path d={`M104 ${y} h${[150, 182, 96][i]}`} stroke="var(--color-ash-light)" stroke-width="1.4" stroke-linecap="round" />
    ))
  }
</svg>
