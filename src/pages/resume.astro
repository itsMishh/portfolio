---
import Base from '../layouts/Base.astro';
import { profile } from '../data/content';

const title = `Résumé — ${profile.name}`;
const description = `${profile.name}'s résumé: Software Developer (.NET) in the Toronto area.`;
const pdf = profile.resumePdf;
const fileName = pdf.split('/').pop();
---

<Base title={title} description={description}>
  <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-8 md:py-12">
    <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <a href="/" class="font-mono text-xs text-ash transition-opacity hover:opacity-70">← mishapunj.com</a>
        <h1 class="mt-2 font-display text-5xl leading-none font-bold text-ink md:text-6xl">Résumé</h1>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href={pdf}
          download={fileName}
          class="inline-flex items-center gap-2 rounded-sm border-[1.5px] border-ink bg-ink px-4 py-2 font-mono text-sm text-cream transition-opacity hover:opacity-80"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M7 2v8M3.5 6.5L7 10l3.5-3.5M2 12h10" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Download PDF
        </a>
        <a
          href={pdf}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-ink underline decoration-ash-light decoration-dashed underline-offset-4 transition-opacity hover:opacity-70"
        >
          Open full screen ↗
        </a>
      </div>
    </header>

    <div class="flex-1 overflow-hidden rounded-sm border-[1.5px] border-dashed border-ash-light bg-cream-dark">
      <object data={`${pdf}#view=FitH`} type="application/pdf" class="block h-[80vh] min-h-[600px] w-full" aria-label={`${profile.name} résumé`}>
        <!-- Shown where the browser can't display PDFs inline (most phones) -->
        <div class="flex h-full flex-col items-center justify-center gap-3 p-8 text-center">
          <p class="text-sm text-ink-light">Your browser can't show the PDF here.</p>
          <a href={pdf} download={fileName} class="font-mono text-sm text-ink underline decoration-dashed underline-offset-4">
            Download {fileName}
          </a>
        </div>
      </object>
    </div>
  </div>
</Base>
