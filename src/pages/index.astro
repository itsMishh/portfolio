---
import '../styles/global.css';
import SectionHeading from '../components/SectionHeading.astro';
import { profile, experience, skills, education } from '../data/content';

const title = `${profile.name} — Software Developer`;
const description =
  'Software developer in the Toronto area building enterprise applications in C#, .NET, ASP.NET MVC and SQL Server.';

// Code-block token colours from the Figma design
const kw = 'text-ash';
const prop = 'text-ink-light';
const str = 'text-ink';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f5f0e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-2xl px-6 py-16 md:py-24">
      <!-- Corner doodle -->
      <div class="mb-2 flex justify-end opacity-60">
        <svg width="48" height="48" viewBox="0 0 48 48" class="text-ash-light" aria-hidden="true">
          <path d="M6 6 C6 6 8 4 12 5 C16 6 20 8 24 10 C28 12 34 14 40 12" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" stroke-dasharray="3 2" />
          <path d="M6 6 C6 8 4 14 5 20 C6 26 8 32 6 40" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" stroke-dasharray="3 2" />
          <circle cx="6" cy="6" r="2" fill="currentColor" opacity="0.4" />
        </svg>
      </div>

      <header class="mb-14">
        <p class="mb-3 font-mono text-sm tracking-[0.18em] text-ash uppercase">{profile.eyebrow}</p>
        <h1 class="mb-5 font-display text-7xl leading-none font-bold text-ink md:text-8xl">{profile.name}</h1>

        <svg viewBox="0 0 400 6" class="w-full max-w-md" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,3 C20,1 40,5 60,3 C80,1 100,5 120,3 C140,1 160,5 180,3 C200,1 220,5 240,3 C260,1 280,5 300,3 C320,1 340,5 360,3 C380,1 400,3 400,3" stroke="#4A4844" stroke-width="1.2" fill="none" stroke-linecap="round" />
        </svg>

        <p class="mt-6 max-w-[480px] text-base leading-relaxed text-ink-light md:text-lg">
          I build enterprise applications in
          <span class="relative inline-block">
            C#, .NET and ASP.NET MVC
            <svg viewBox="0 0 100 4" class="absolute -bottom-1 left-0 w-full" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0,2 C15,0.5 30,3.5 50,2 C70,0.5 85,3.5 100,2" stroke="#1A1916" stroke-width="1.5" fill="none" stroke-linecap="round" />
            </svg>
          </span>{' '}on Microsoft SQL Server, connected through REST APIs. I work in an Agile team on Azure DevOps with Git and
          GitFlow, and I care about clean architecture and code the next developer can read.
        </p>
      </header>

      <section class="mb-14" aria-label="Developer identity code snippet">
        <div class="overflow-x-auto rounded-sm border-[1.5px] border-dashed border-ash-light bg-cream-dark p-5 md:p-6">
<pre class="font-mono text-xs leading-relaxed whitespace-pre text-ink md:text-sm"><span class={kw}>var</span> misha = <span class={kw}>new</span> Developer
&#123;
    <span class={prop}>Name</span>     = <span class={str}>"Misha Punj"</span>,
    <span class={prop}>Role</span>     = <span class={str}>"Software Developer @ IIMSWISS Corp."</span>,
    <span class={prop}>Stack</span>    = [<span class={str}>"C#"</span>, <span class={str}>".NET"</span>, <span class={str}>"ASP.NET MVC"</span>, <span class={str}>"SQL Server"</span>],
    <span class={prop}>Tools</span>    = [<span class={str}>"Azure DevOps (TFS)"</span>, <span class={str}>"Git"</span>, <span class={str}>"GitFlow"</span>],
    <span class={prop}>Location</span> = <span class={str}>"Oakville, ON"</span>
&#125;;  <span class={kw}>// open to software engineering roles</span>

<span class={kw}>// off the clock: debugging French irregular verbs.</span>
<span class={kw}>// the C# compiler is far more forgiving.</span></pre>
        </div>
      </section>

      <section class="mb-14">
        <SectionHeading number="01" label="Experience" />
        {
          experience.map((job) => (
            <div class="mt-6">
              <div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-base font-semibold">{job.title}</h3>
                <span class="shrink-0 font-mono text-xs text-ash">{job.when}</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-light">{job.body}</p>
            </div>
          ))
        }
      </section>

      <section class="mb-14">
        <SectionHeading number="02" label="Skills" />
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            Object.entries(skills).map(([category, items]) => (
              <div>
                <p class="mb-3 font-mono text-xs tracking-[0.14em] text-ash uppercase">{category}</p>
                <div class="flex flex-wrap gap-2">
                  {items.map((skill) => (
                    <span class="rounded-sm border-[1.5px] border-dashed border-ash-light px-2.5 py-1 text-xs text-ink">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mb-14">
        <SectionHeading number="03" label="Education & Credentials" />
        <div class="mt-6 space-y-8">
          {
            education.map((e) => (
              <div class="border-l-[1.5px] border-dashed border-ash-light pl-4">
                <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="text-base font-semibold">{e.degree}</h3>
                  <span class="shrink-0 font-mono text-xs text-ash">{e.period}</span>
                </div>
                <p class="mb-1 text-sm font-medium text-ink-light">{e.school}</p>
                {e.note && <p class="text-sm leading-relaxed text-ash">{e.note}</p>}
              </div>
            ))
          }
        </div>
      </section>

      <section class="mb-10">
        <SectionHeading number="04" label="Reach me" />
        <div class="mt-6 flex flex-col gap-4 sm:flex-row">
          <button
            id="copy-email"
            type="button"
            data-email={profile.email}
            class="flex cursor-pointer items-center gap-2 font-mono text-sm text-ink transition-opacity hover:opacity-70"
            aria-label="Copy email address"
          >
            <span data-dot class="h-1.5 w-1.5 shrink-0 rounded-full bg-ink transition-colors duration-200"></span>
            <span data-label>{profile.email}</span>
          </button>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 font-mono text-sm text-ink transition-opacity hover:opacity-70"
          >
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-ink"></span>
            LinkedIn
            <svg width="14" height="14" viewBox="0 0 14 14" class="ml-1 inline-block translate-y-px" aria-hidden="true">
              <path d="M2 7h9M8 3.5l3.5 3.5L8 10.5" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </section>

      <footer class="mt-8 border-t-[1.5px] border-dashed border-ash-light pt-8">
        <div class="flex items-center justify-between">
          <p class="font-mono text-xs text-ash">© {new Date().getFullYear()} {profile.name}</p>
          <p class="font-mono text-xs text-ash-light">more projects soon</p>
        </div>
      </footer>
    </div>

    <script>
      const btn = document.getElementById('copy-email');
      const label = btn?.querySelector<HTMLElement>('[data-label]');
      const dot = btn?.querySelector<HTMLElement>('[data-dot]');
      btn?.addEventListener('click', async () => {
        if (!label || !dot) return;
        const email = btn.dataset.email ?? '';
        try {
          await navigator.clipboard.writeText(email);
          label.textContent = 'copied!';
        } catch {
          label.textContent = 'copy failed';
        }
        dot.classList.replace('bg-ink', 'bg-ash');
        setTimeout(() => {
          label.textContent = email;
          dot.classList.replace('bg-ash', 'bg-ink');
        }, 2000);
      });
    </script>
  </body>
</html>
